{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/about",       "destination": "/about.html" },
    { "source": "/service",     "destination": "/service.html" },
    { "source": "/service-div", "destination": "/service-div.html" },
    { "source": "/contact",     "destination": "/contact.html" },
    { "source": "/appointment", "destination": "/appointment.html" },
    { "source": "/estimate",    "destination": "/estimate.html" }
  ],
  "headers": [
    {
      "source": "/(css|js|img|lucky_image)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",          "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy",          "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
